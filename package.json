{
  "name": "agentic-qa-toolshop",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic QA suite for the Restful-booker platform demo app: Claude Code agents over Playwright MCP, with E2E, API, visual and accessibility suites.",
  "author": "Víctor Martín Aller",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox --project=e2e-webkit",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:a11y": "playwright test --project=a11y",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "feed": "node scripts/build-run-feed.js",
    "feed:test": "node --test scripts/build-run-feed.test.js",
    "report": "allure generate allure-results -o allure-report --clean && allure open allure-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "typescript": "^6.0.3"
  }
}
